  "hierarchy": [
    {
      "id": "page",
      "definition": "Pantalla con objetivo único y contexto",
      "children": [
        "section",
        "workspace",
        "action-bar"
      ],
      "rules": [
        "Un H1 visible por vista",
        "Contexto y acciones generales en pageTop",
        "No transformar navegación en fuente de reglas"
      ]
    },
    {
      "id": "section",
      "definition": "Unidad funcional de trabajo",
      "children": [
        "subsection",
        "block",
        "group",
        "field",
        "datum"
      ],
      "rules": [
        "H2 o etiqueta semántica equivalente",
        "Acciones de sección en cabecera",
        "No exige una card anidada"
      ]
    },
    {
      "id": "subsection",
      "definition": "Parte o fase de una sección",
      "children": [
        "block",
        "group",
        "field",
        "datum"
      ],
      "rules": [
        "Título H3 según árbol real",
        "No crear superficie visual automáticamente",
        "Su plegado requiere affordance y estado"
      ]
    },
    {
      "id": "block",
      "definition": "Entidad operable: paso/riesgo/alternativa/registro",
      "children": [
        "group",
        "field",
        "datum"
      ],
      "rules": [
        "Una identidad y acciones contextualizadas",
        "Card solo si aporta separación/selección",
        "Sin propietario duplicado del dato"
      ]
    },
    {
      "id": "group",
      "definition": "Conjunto lógico de campos o datos",
      "children": [
        "field",
        "datum"
      ],
      "rules": [
        "Agrupación por etiqueta y espacio",
        "Evitar bordes/fondos redundantes",
        "Visibilidad gobernada por condición canónica"
      ]
    },
    {
      "id": "field",
      "definition": "Captura del dato propiedad de una única vista",
      "children": [],
      "rules": [
        "Label y control asociados",
        "Valor, validación y procedencia canónicos",
        "No repetir captura en inspector"
      ]
    },
    {
      "id": "datum",
      "definition": "Lectura de dato con fuente y unidad cuando aplica",
      "children": [],
      "rules": [
        "Etiqueta, valor, unidad y estado por fuente",
        "Ausente distinto de cero",
        "Readonly fuera del owner"
      ]
    }
  ],
